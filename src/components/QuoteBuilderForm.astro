---
import { brand, flakePalettes } from '../data/siteData';
import { quoteServices } from '../data/quoteOptions';
---

<section class="estimate-cta-section" id="quote-builder" aria-labelledby="quote-heading">
  <!-- Atmospheric Jobsite & Coating Backdrop with Dark Reading Scrim -->
  <div class="estimate-backdrop" aria-hidden="true">
    <img
      src="/images/projects/warehouse-flake-epoxy-after.png"
      alt=""
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
      class="estimate-bg-img"
    />
    <div class="estimate-scrim"></div>
  </div>

  <div class="container estimate-container">
    <div class="estimate-grid">
      <!-- Left Column: Dark Headline & Direct Contractor Info (Exact Reference Mockup Layout) -->
      <div class="estimate-copy-col">
        <div class="section-kicker">
          <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="kicker-text kicker-text-light">Get a Free Estimate</span>
        </div>

        <h2 id="quote-heading" class="estimate-title">
          Ready to Transform<br />
          <span class="accent-blue">Your Property?</span>
        </h2>

        <p class="estimate-lead">
          Tell us about the work you have in mind. Contact <strong>{brand.president}</strong> and the AAC Painters team to discuss the scope, scheduling, and next steps for an estimate.
        </p>

        <dl class="estimate-credentials">
          <div class="cred-item">
            <dt>Direct Field Line</dt>
            <dd><a href={brand.phoneHref}>{brand.phoneDisplay}</a></dd>
          </div>
          <div class="cred-item">
            <dt>California License</dt>
            <dd>{brand.license} &bull; {brand.insurance}</dd>
          </div>
          <div class="cred-item">
            <dt>Project Scopes</dt>
            <dd>Residential, Commercial &amp; Industrial Epoxy</dd>
          </div>
        </dl>
      </div>

      <!-- Right Column: Crisp Floating White Estimate Form Card (Exact Reference Mockup Layout) -->
      <div class="estimate-white-card">
        <form id="aac-quote-form" class="estimate-form" action="/api/quote" method="POST" novalidate>
          <h3 class="sr-only">Request Your Free Estimate</h3>

          <!-- Row 1: Name * & Phone * -->
          <div class="form-row-2">
            <div class="field-group">
              <label for="fullName" class="field-label">
                Name <span class="req-star" aria-hidden="true">*</span>
              </label>
              <p class="field-hint" id="name-hint">Full name or business contact</p>
              <input
                type="text"
                id="fullName"
                name="name"
                class="field-input"
                autocomplete="name"
                required
                minlength="2"
                maxlength="120"
                aria-describedby="name-hint name-error"
              />
              <p class="field-error" id="name-error" role="alert">Please enter your name.</p>
            </div>

            <div class="field-group">
              <label for="phone" class="field-label">
                Phone <span class="req-star" aria-hidden="true">*</span>
              </label>
              <p class="field-hint" id="phone-hint">10-digit number for call or text</p>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="field-input"
                autocomplete="tel"
                inputmode="tel"
                required
                maxlength="30"
                aria-describedby="phone-hint phone-error"
              />
              <p class="field-error" id="phone-error" role="alert">Please enter a valid 10-digit phone number.</p>
            </div>
          </div>

          <!-- Row 2: Email & City * -->
          <div class="form-row-2">
            <div class="field-group">
              <label for="email" class="field-label">Email</label>
              <p class="field-hint" id="email-hint">Optional — for estimate follow-up</p>
              <input
                type="email"
                id="email"
                name="email"
                class="field-input"
                autocomplete="email"
                maxlength="254"
                inputmode="email"
                aria-describedby="email-hint email-error"
              />
              <p class="field-error" id="email-error" role="alert">Please enter a valid email address.</p>
            </div>

            <div class="field-group">
              <label for="city" class="field-label">
                City / Location <span class="req-star" aria-hidden="true">*</span>
              </label>
              <p class="field-hint" id="city-hint">e.g., Modesto, Turlock, Stockton, Tracy</p>
              <input
                type="text"
                id="city"
                name="city"
                class="field-input"
                autocomplete="address-level2"
                required
                minlength="2"
                maxlength="120"
                aria-describedby="city-hint city-error"
              />
              <p class="field-error" id="city-error" role="alert">Please enter the project city.</p>
            </div>
          </div>

          <!-- Row 3: Service Scope * & Property Type -->
          <div class="form-row-2">
            <div class="field-group">
              <label for="serviceType" class="field-label">
                What are you interested in? <span class="req-star" aria-hidden="true">*</span>
              </label>
              <p class="field-hint" id="service-hint">Choose the main service for this request</p>
              <select id="serviceType" name="services" class="field-input" required aria-describedby="service-hint">
                {quoteServices.map((service) => (
                  <option value={service.value}>{service.label}</option>
                ))}
              </select>
            </div>

            <div class="field-group">
              <label for="propertyScope" class="field-label">Property / Work Area</label>
              <p class="field-hint" id="scope-hint">Optional — choose the closest match</p>
              <select id="propertyScope" name="propertyType" class="field-input" aria-describedby="scope-hint">
                <option value="">Not sure yet — discuss with estimator</option>
                {quoteServices[0].propertyTypes.map((property) => <option value={property}>{property}</option>)}
              </select>
            </div>
          </div>

          <!-- Optional and service-specific; also synced from the Coating Lab. -->
          <div class="field-group" id="finish-field">
            <label for="preferredFinish" class="field-label">Finish or Color Direction (Optional)</label>
            <select id="preferredFinish" name="selectedFinish" class="field-input">
              <option value="">Undecided — discuss options with estimator</option>
              {flakePalettes.map((p) => (
                <option value={p.name} data-finish-type={p.category === 'Exterior Architectural' ? 'paint' : 'floor'}>{p.name} ({p.category})</option>
              ))}
              <option value="Custom Architectural Paint Color Match" data-finish-type="paint">Custom Paint / Coating Color Match</option>
              <option value="Natural Wood Tone" data-finish-type="stain">Natural Wood Tone</option>
              <option value="Custom Stain Color" data-finish-type="stain">Custom Stain Color</option>
            </select>
          </div>

          <!-- Row 4: Project Details -->
          <div class="field-group">
            <label for="projectDetails" class="field-label">Tell us about your project</label>
            <p class="field-hint" id="details-hint">Approximate square footage, current surface condition, or target timeline</p>
            <textarea
              id="projectDetails"
              name="projectDetails"
              rows="3"
              maxlength="5000"
              class="field-input field-textarea"
              aria-describedby="details-hint"
            ></textarea>
          </div>

          <!-- Honeypot -->
          <div class="sr-only" aria-hidden="true">
            <label for="companyWebsite">Leave empty</label>
            <input type="text" id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-dark submit-estimate-btn" id="quote-submit-btn">
            <span>Request My Free Estimate</span>
            <span aria-hidden="true">&rarr;</span>
          </button>

          <p class="field-hint">Prefer to talk? <a href={brand.phoneHref}>Call {brand.phoneDisplay}</a> or <a href="sms:+12094855103" id="quote-text-link">text your project details</a>.</p>

          <div class="form-feedback" id="quote-feedback" role="status" aria-live="polite" hidden></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .estimate-cta-section {
    position: relative;
    padding: 5.5rem 1.5rem;
    background-color: var(--bg-dark-deep);
    color: var(--text-light);
    overflow: hidden;
  }

  .estimate-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .estimate-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    opacity: 0.32;
  }

  .estimate-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(9, 13, 18, 0.96) 0%,
      rgba(14, 20, 27, 0.88) 48%,
      rgba(14, 20, 27, 0.68) 100%
    );
  }

  .estimate-container {
    position: relative;
    z-index: 1;
  }

  .estimate-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 3rem;
    align-items: center;
  }

  .estimate-title {
    font-size: clamp(2.25rem, 4vw, 3.35rem);
    line-height: 1.06;
    color: var(--text-light);
    margin-bottom: 1.15rem;
  }

  .estimate-lead {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--text-light-secondary);
    margin-bottom: 2rem;
  }

  .estimate-lead strong {
    color: var(--text-light);
  }

  .estimate-credentials {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem 0 0 0;
    border-top: 1px solid var(--border-dark);
  }

  .cred-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.92rem;
  }

  .cred-item dt {
    color: var(--text-light-muted);
  }

  .cred-item dd {
    font-weight: 700;
    color: var(--text-light);
    text-align: right;
  }

  .cred-item a {
    color: var(--aac-blue);
    font-family: var(--font-mono);
  }

  /* Crisp Floating White Card from Reference Mockup */
  .estimate-white-card {
    background-color: var(--bg-white);
    color: var(--text-dark);
    padding: 2.5rem;
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .estimate-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .field-group {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .field-group[hidden] {
    display: none;
  }

  .field-label {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.15rem;
  }

  .req-star {
    color: var(--aac-red);
  }

  .field-hint {
    font-size: 0.85rem;
    color: var(--text-dark-muted);
    margin-bottom: 0.35rem;
    line-height: 1.35;
  }

  .field-input {
    min-width: 0;
    width: 100%;
    padding: 0.72rem 0.9rem;
    background-color: var(--bg-light);
    border: 1px solid var(--border-light-strong);
    border-radius: 3px;
    color: var(--text-dark);
    font-size: 0.94rem;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .field-input:focus {
    outline: 2px solid var(--aac-blue-deep);
    outline-offset: 0;
    background-color: var(--bg-white);
  }

  .field-textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .field-error {
    display: none;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--state-error);
  }

  @supports selector(:user-invalid) {
    .field-input:user-invalid {
      border-color: var(--state-error);
      background-color: #fdf4f3;
    }

    .field-input:user-valid {
      border-color: var(--state-success);
    }

    .field-input:user-invalid ~ .field-error {
      display: block;
    }
  }

  .field-input.touched:invalid {
    border-color: var(--state-error);
    background-color: #fdf4f3;
  }

  .field-input.touched:valid {
    border-color: var(--state-success);
  }

  .field-input.touched:invalid ~ .field-error {
    display: block;
  }

  .submit-estimate-btn {
    width: 100%;
    padding-block: 1.05rem;
    margin-top: 0.35rem;
    font-size: 0.92rem;
    background-color: var(--bg-dark);
    color: var(--text-light);
  }

  .submit-estimate-btn:hover {
    background-color: var(--aac-blue-deep);
    border-color: var(--aac-blue-deep);
  }

  .form-feedback {
    overflow-wrap: anywhere;
    padding: 0.9rem 1.1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    border-radius: 3px;
  }

  .form-feedback.is-success {
    background: #eef6f0;
    border: 1px solid var(--state-success);
    color: #164424;
  }

  .form-feedback.is-error {
    background: #fdf3f2;
    border: 1px solid var(--state-error);
    color: #7d1d14;
  }

  @media (max-width: 980px) {
    .estimate-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { getQuoteService, isValidPhone } from '../data/quoteOptions';

  const form = document.querySelector<HTMLFormElement>('#aac-quote-form');
  const feedback = document.querySelector<HTMLElement>('#quote-feedback');
  const submitBtn = document.querySelector<HTMLButtonElement>('#quote-submit-btn');
  const textLink = document.querySelector<HTMLAnchorElement>('#quote-text-link');

  if (form) {
    const inputs = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('.field-input');
    const serviceSelect = form.querySelector<HTMLSelectElement>('#serviceType')!;
    const propertySelect = form.querySelector<HTMLSelectElement>('#propertyScope')!;
    const finishSelect = form.querySelector<HTMLSelectElement>('#preferredFinish')!;
    const finishField = form.querySelector<HTMLElement>('#finish-field')!;
    const phone = form.querySelector<HTMLInputElement>('#phone')!;
    const finishOptions = Array.from(finishSelect.options).map((option) => option.cloneNode(true) as HTMLOptionElement);
    let submitting = false;

    const syncServiceOptions = () => {
      const service = getQuoteService(serviceSelect.value);
      const previousProperty = propertySelect.value;
      const previousFinish = finishSelect.value;
      propertySelect.replaceChildren(new Option('Not sure yet — discuss with estimator', ''));
      service?.propertyTypes.forEach((property) => propertySelect.add(new Option(property, property)));
      if (service?.propertyTypes.includes(previousProperty)) propertySelect.value = previousProperty;
      finishSelect.replaceChildren(...finishOptions
        .filter((option) => !option.value || option.dataset.finishType === service?.finishType)
        .map((option) => option.cloneNode(true)));
      if (Array.from(finishSelect.options).some((option) => option.value === previousFinish)) finishSelect.value = previousFinish;
      finishField.hidden = service?.finishType === 'none';
      finishSelect.disabled = finishField.hidden;
      if (finishField.hidden) finishSelect.value = '';
    };
    syncServiceOptions();
    const updateTextLink = () => {
      if (!textLink) return;
      const values = new FormData(form);
      const details = [
        "Hi AAC Painters, I'd like an estimate.",
        `Name: ${values.get('name') || ''}`,
        `Phone: ${values.get('phone') || ''}`,
        `Email: ${values.get('email') || 'Not specified'}`,
        `City: ${values.get('city') || ''}`,
        `Service: ${values.get('services') || ''}`,
        `Property: ${values.get('propertyType') || 'Not specified'}`,
        `Finish: ${values.get('selectedFinish') || (finishField.hidden ? 'Not applicable' : 'Not specified')}`,
        `Details: ${values.get('projectDetails') || ''}`,
      ].join('\n');
      textLink.href = `sms:+12094855103?&body=${encodeURIComponent(details)}`;
    };
    textLink?.addEventListener('click', updateTextLink);
    form.addEventListener('input', updateTextLink);
    form.addEventListener('change', updateTextLink);
    serviceSelect.addEventListener('change', syncServiceOptions);
    document.addEventListener('aac:finish-selected', ((event: CustomEvent<{ finish: string; category: string }>) => {
      serviceSelect.value = event.detail.category === 'Exterior Architectural'
        ? 'Commercial Painting & Stucco Restoration'
        : event.detail.category === 'Auto Bay & High-Gloss'
          ? 'Metallic & Solid-Color Epoxy Floor' : 'Full-Broadcast Flake Epoxy Floor';
      syncServiceOptions();
      if (Array.from(finishSelect.options).some((option) => option.value === event.detail.finish)) {
        finishSelect.value = event.detail.finish;
      }
    }) as EventListener);

    const validate = (input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      if (input === phone) phone.setCustomValidity(isValidPhone(phone.value) ? '' : 'Enter a valid 10-digit phone number.');
      if (input.id === 'fullName' || input.id === 'city') {
        input.setCustomValidity(input.value.trim().length >= 2 ? '' : 'Please enter at least two characters.');
      }
      if (input.classList.contains('touched')) input.setAttribute('aria-invalid', String(!input.validity.valid));
    };
    inputs.forEach((input) => {
      input.addEventListener('blur', () => {
        if (input.value) input.classList.add('touched');
        validate(input);
      });
      input.addEventListener('input', () => validate(input));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      let firstInvalid: HTMLElement | null = null;
      inputs.forEach((input) => {
        if (input.disabled) return;
        input.classList.add('touched');
        validate(input);
        if (!input.validity.valid && !firstInvalid) firstInvalid = input;
      });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        return;
      }

      submitting = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending Estimate Request...';
      }
      if (feedback) {
        feedback.hidden = true;
        feedback.className = 'form-feedback';
      }
      const submittedPayload = JSON.stringify(Object.fromEntries(new FormData(form).entries()));
      try {
        const response = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: submittedPayload
        });
        const result = await response.json();
        if (response.ok && result.ok) {
          if (feedback) {
            feedback.hidden = false;
            feedback.classList.add('is-success');
            feedback.textContent = `Estimate request sent (Ref ${result.quoteId}). ${result.message}`;
          }
          if (JSON.stringify(Object.fromEntries(new FormData(form).entries())) === submittedPayload) {
            form.reset();
            syncServiceOptions();
          } else if (feedback) {
            feedback.textContent += ' Your newer edits are still in the form and have not been sent.';
          }
          if (textLink) textLink.href = 'sms:+12094855103';
          inputs.forEach((input) => {
            input.classList.remove('touched');
            input.removeAttribute('aria-invalid');
            input.setCustomValidity('');
          });
        } else {
          if (textLink && typeof result.smsLink === 'string' && result.smsLink.startsWith('sms:+12094855103?')) {
            textLink.href = result.smsLink;
          }
          throw new Error(result.error || 'Could not submit your request. Please call (209) 485-5103.');
        }
      } catch (error) {
        if (feedback) {
          feedback.hidden = false;
          feedback.classList.add('is-error');
          feedback.textContent = error instanceof Error ? error.message : 'Could not confirm delivery. Please call or text (209) 485-5103.';
        }
      } finally {
        submitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Request My Free Estimate</span> <span aria-hidden="true">&rarr;</span>';
        }
      }
    });
  }
</script>
