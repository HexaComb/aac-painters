---
const projectPlanning = [
  {
    title: 'Define Your Scope',
    description:
      'Tell us which rooms, surfaces or outdoor areas you want to update, along with any repairs or existing finish concerns.',
    detail: 'Painting, staining, cleaning and floor coatings'
  },
  {
    title: 'Plan Property Access',
    description:
      'Share the details that affect access, such as parked vehicles, stored items, business hours or occupied rooms.',
    detail: 'Homes, businesses and shared properties'
  },
  {
    title: 'Discuss Finish and Timing',
    description:
      'Bring your color ideas and target dates. Ask which preparation steps, materials and drying or cure times belong in your estimate.',
    detail: 'A scope tailored to your project'
  }
];
---

<section class="reviews-reels-section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <!-- Top Header Row Matching Reference Mockup -->
    <div class="reviews-header-row">
      <div>
        <div class="section-kicker">
          <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="kicker-text kicker-text-light">Plan Your Project</span>
        </div>
        <h2 id="reviews-heading" class="reviews-main-title">
          A Clearer Plan. <span class="accent-blue">A Better Start.</span>
        </h2>
      </div>

      <a href="#quote-builder" class="arrow-link arrow-link-light">
        <span>Request Your Free Estimate</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Project-planning guidance, not customer testimonials -->
    <div class="reviews-grid">
      {projectPlanning.map((item) => (
        <article class="review-card">
          <h3 class="review-title">{item.title}</h3>
          <p class="review-description">{item.description}</p>
          <p class="review-scope">{item.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews-reels-section {
    padding: 5.5rem 1.5rem;
    background-color: var(--bg-dark);
    color: var(--text-light);
  }

  .reviews-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .reviews-main-title {
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    color: var(--text-light);
  }

  /* 3-Column Project Planning Cards */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .review-card {
    background-color: var(--bg-dark-elevated);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .review-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--text-light);
  }

  .review-description {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-light-secondary);
    flex: 1;
  }

  .review-scope {
    font-size: 0.85rem;
    color: var(--text-light-muted);
  }

  @media (max-width: 980px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
