---
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  summary: string;
  projectNote: string;
  considerations: string[];
  related: { href: string; label: string }[];
}
const { id, eyebrow, heading, summary, projectNote, considerations, related } = Astro.props;
---

<section class="service-location-section" aria-labelledby={id}>
  <div class="container service-location-grid">
    <div class="service-location-copy">
      <p class="service-location-eyebrow">{eyebrow}</p>
      <h2 id={id}>{heading}</h2>
      <p>{summary}</p>
      <p>{projectNote} <a href="/projects/">Explore before-and-after projects</a>.</p>
      <nav class="service-related-links" aria-label="Explore related services">
        {related.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">&rarr;</span></a>)}
      </nav>
    </div>
    <div class="service-location-panel">
      <h3>What to share for your estimate</h3>
      <ul>{considerations.map((point) => <li>{point}</li>)}</ul>
      <a href="#quote-builder" class="service-location-cta">Request a Free Estimate <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>

<style>
  .service-location-section { padding: 4.5rem 1.5rem; background: var(--bg-white); border-bottom: 1px solid var(--border-light); }
  .service-location-grid { display: grid; grid-template-columns: 6fr 5fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .service-location-eyebrow { font-family: var(--font-mono); font-size: .8rem; font-weight: 600; letter-spacing: .045em; color: var(--aac-blue-deep); margin-bottom: .9rem; }
  h2 { font-size: clamp(1.9rem, 3.5vw, 2.9rem); color: var(--text-dark); line-height: 1.16; margin-bottom: 1.2rem; }
  .service-location-copy > p:not(.service-location-eyebrow) { color: var(--text-dark-secondary); line-height: 1.75; max-width: 63ch; margin-bottom: 1rem; }
  .service-location-copy a { color: var(--aac-blue-deep); text-underline-offset: 3px; }
  .service-related-links { display: flex; flex-wrap: wrap; gap: 1rem 1.6rem; margin-top: 1.6rem; font-size: .92rem; }
  .service-location-panel { background: var(--bg-light); border: 1px solid var(--border-light); border-radius: 4px; padding: clamp(1.5rem, 3vw, 2.2rem); }
  h3 { font-size: clamp(1.15rem, 2vw, 1.45rem); color: var(--text-dark); margin-bottom: 1rem; }
  .service-location-panel ul { padding-left: 1.25rem; margin: 0 0 1.65rem; }
  .service-location-panel li { line-height: 1.6; padding: .3rem 0; color: var(--text-dark-secondary); }
  .service-location-panel li::marker { color: var(--aac-blue-deep); }
  .service-location-cta { color: var(--text-dark); font-weight: 700; text-underline-offset: 4px; }
  @media (max-width: 780px) { .service-location-grid { grid-template-columns: 1fr; } }
</style>
