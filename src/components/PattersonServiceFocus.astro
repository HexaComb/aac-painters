---
import { brand } from '../data/siteData';
---

<section id="patterson-painting" class="patterson-focus" aria-labelledby="patterson-focus-heading">
  <div class="container focus-layout">
    <div class="focus-intro">
      <p class="focus-eyebrow">PATTERSON, CALIFORNIA</p>
      <h2 id="patterson-focus-heading">Painting for Patterson homes and businesses.</h2>
      <p>
        Whether you are planning a room refresh, an exterior repaint or work on an occupied
        commercial property, tell AAC Painters about your surfaces, timing and access needs.
        Our team focuses on Patterson and also discusses projects throughout the Bay Area
        and Central Valley.
      </p>
      <p class="proof-note">
        Explore our documented before-and-after work. Photos reflect actual AAC projects
        across our service area; individual locations are identified where known.
      </p>
      <div class="focus-actions">
        <a class="focus-estimate" href="#quote-builder">Request a Free Estimate <span aria-hidden="true">&rarr;</span></a>
        <a class="focus-call" href={brand.phoneHref}>Call {brand.phoneDisplay}</a>
      </div>
    </div>
    <nav class="focus-links" aria-label="Painting services for Patterson">
      <a href="/services/residential-painting/"><span>For homeowners</span><strong>Interior &amp; exterior house painting</strong><span aria-hidden="true">&rarr;</span></a>
      <a href="/services/commercial-painting/"><span>For property managers &amp; businesses</span><strong>Commercial &amp; industrial painting</strong><span aria-hidden="true">&rarr;</span></a>
      <a href="/services/epoxy/"><span>Discuss your application</span><strong>Epoxy project inquiries</strong><span aria-hidden="true">&rarr;</span></a>
      <a href="/projects/"><span>See the craftsmanship</span><strong>Real before-and-after projects</strong><span aria-hidden="true">&rarr;</span></a>
    </nav>
  </div>
</section>

<style>
  .patterson-focus { padding: clamp(3.5rem, 7vw, 6rem) 1.5rem; background: #eef3f7; color: #132a3e; }
  .focus-layout { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: start; gap: clamp(2rem, 6vw, 6rem); }
  .focus-eyebrow { font-family: var(--font-mono); font-size: .76rem; font-weight: 700; letter-spacing: .08em; color: #175d8a; }
  h2 { font-size: clamp(2rem, 3.8vw, 3.5rem); line-height: 1.14; letter-spacing: -.025em; max-width: 15ch; margin: 1rem 0 1.2rem; }
  .focus-intro > p:not(.focus-eyebrow) { max-width: 61ch; line-height: 1.7; margin-bottom: 1rem; }
  .proof-note { font-size: .9rem; color: #3f5c70; }
  .focus-actions { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; margin-top: 2rem; }
  .focus-estimate { background: #142c40; color: white; padding: .9rem 1.25rem; text-decoration: none; border-radius: 3px; font-weight: 700; }
  .focus-estimate:hover, .focus-estimate:focus-visible { background: #176394; }
  .focus-call { color: #142c40; text-underline-offset: 4px; font-weight: 700; }
  .focus-links { display: grid; border-top: 1px solid #c8d7e1; }
  .focus-links a { display: grid; grid-template-columns: 1fr auto; gap: .25rem 1rem; color: #142c40; padding: 1.3rem .2rem; border-bottom: 1px solid #c8d7e1; text-decoration: none; }
  .focus-links a span:first-child { grid-column: 1; font-size: .78rem; color: #4c6678; }
  .focus-links a strong { grid-column: 1; font-size: 1.09rem; line-height: 1.4; }
  .focus-links a span:last-child { grid-column: 2; grid-row: 1 / 3; align-self: center; font-size: 1.45rem; }
  .focus-links a:hover strong, .focus-links a:focus-visible strong { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 800px) { .focus-layout { grid-template-columns: 1fr; } h2 { max-width: none; } }
</style>