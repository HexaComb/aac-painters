<script>
  import { initBeforeAfterSliders } from '../scripts/beforeAfterBrush';

  function initHomeInteractions() {
    // Pause autoplaying videos when the user prefers reduced motion
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    function syncReducedMotion(prefersReducedMotion: boolean) {
      for (const video of document.querySelectorAll<HTMLVideoElement>('video[autoplay]')) {
        if (prefersReducedMotion) {
          video.removeAttribute('autoplay');
          video.pause();
        }
      }
    }
    syncReducedMotion(reducedMotionQuery.matches);
    reducedMotionQuery.addEventListener('change', (event) => {
      syncReducedMotion(event.matches);
    });



    // 2. Services Photo Hover/Focus Preview
    const serviceCols = document.querySelectorAll<HTMLAnchorElement>('[data-service-preview]');
    const serviceImg = document.querySelector<HTMLImageElement>('#services-preview-img');
    const serviceCaption = document.querySelector<HTMLElement>('#services-preview-caption');

    serviceCols.forEach((col) => {
      const swap = () => {
        const src = col.dataset.servicePreview;
        const cap = col.dataset.serviceCaption;
        if (serviceImg && src) serviceImg.src = src;
        if (serviceCaption && cap) serviceCaption.textContent = cap;
      };
      col.addEventListener('mouseenter', swap);
      col.addEventListener('focus', swap);
    });

    // 3. Before & After Paintbrush Sliders (Shared Controller)
    initBeforeAfterSliders();

    const showcaseRows = document.querySelectorAll<HTMLElement>('[data-ba-showcase]');
    showcaseRows.forEach((row) => {
      const pills = row.querySelectorAll<HTMLButtonElement>('.ba-thumb-pill');
      const videoEl = row.querySelector<HTMLVideoElement>('[data-showcase-video]');
      const sliderLayers = row.querySelector<HTMLElement>('[data-showcase-slider-layers]');
      const beforeImg = row.querySelector<HTMLImageElement>('[data-showcase-before]');
      const afterImg = row.querySelector<HTMLImageElement>('[data-showcase-after]');
      const kickerEl = row.querySelector<HTMLElement>('[data-showcase-kicker]');
      const headlineEl = row.querySelector<HTMLElement>('[data-showcase-headline]');
      const storyEl = row.querySelector<HTMLElement>('[data-showcase-story]');
      const specEl = row.querySelector<HTMLElement>('[data-showcase-spec]');

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            const active = p === pill;
            p.classList.toggle('is-active', active);
            p.setAttribute('aria-pressed', String(active));
          });

          const pillVideo = pill.dataset.video;
          if (pillVideo && videoEl) {
            if (videoEl.getAttribute('src') !== pillVideo) {
              videoEl.src = pillVideo;
            }
            videoEl.hidden = false;
            if (!reducedMotionQuery.matches) {
              videoEl.play().catch(() => {});
            }
            if (sliderLayers) sliderLayers.hidden = true;
          } else {
            if (videoEl) {
              videoEl.pause();
              videoEl.hidden = true;
            }
            if (sliderLayers) sliderLayers.hidden = false;
            if (beforeImg && pill.dataset.before) {
              beforeImg.src = pill.dataset.before;
              beforeImg.alt = pill.dataset.beforeAlt || '';
            }
            if (afterImg && pill.dataset.after) {
              afterImg.src = pill.dataset.after;
              afterImg.alt = pill.dataset.afterAlt || '';
            }
          }
          if (kickerEl && pill.dataset.kicker) {
            kickerEl.textContent = pill.dataset.kicker;
          }
          if (headlineEl && pill.dataset.headline) {
            headlineEl.textContent = pill.dataset.headline;
          }
          if (storyEl && pill.dataset.story) {
            storyEl.textContent = pill.dataset.story;
          }
          if (specEl && pill.dataset.spec) {
            specEl.innerHTML = `<strong>System:</strong> ${pill.dataset.spec}`;
          }
        });
      });
    });
  }

  initHomeInteractions();
  document.addEventListener('astro:page-load', initHomeInteractions);
</script>
