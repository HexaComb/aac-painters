---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryChapters from '../components/StoryChapters.astro';
import FieldReelsSection from '../components/FieldReelsSection.astro';
import QuoteBuilderForm from '../components/QuoteBuilderForm.astro';
import {
  brand,
  faqItems
} from '../data/siteData';

const floorShowcases = [
  {
    label: '2-Car Garage Flake',
    kicker: 'GARAGE & FLOOR COATINGS',
    headline: 'Lorem Ipsum Dolor Sit Amet',
    story:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
    beforeImage: '/images/projects/residential-garage-before.png',
    beforeAlt: 'Before: Residential garage floor before transformation',
    afterImage: '/images/projects/residential-garage-flake-epoxy-after.png',
    afterAlt: 'After: Finished residential garage floor',
    spec: 'Lorem ipsum dolor sit amet consectetur'
  },
  {
    label: 'Auto Bay Mirror Epoxy',
    kicker: 'COMMERCIAL & AUTO SHOP FLOORS',
    headline: 'Consectetur Adipiscing Elit',
    story:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio. Praesent libero. Sed cursus ante dapibus diam. Sed nisi. Nulla quis sem at nibh elementum imperdiet.',
    beforeImage: '/images/projects/auto-shop-floor-before.png',
    beforeAlt: 'Before: Auto service shop floor before transformation',
    afterImage: '/images/projects/auto-shop-epoxy-floor-after.png',
    afterAlt: 'After: Finished auto service shop floor',
    spec: 'Lorem ipsum dolor sit amet consectetur'
  },
  {
    label: 'Warehouse Flake Slab',
    kicker: 'INDUSTRIAL FLOOR SYSTEMS',
    headline: 'Sed Do Eiusmod Tempor Incididunt',
    story:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis sagittis ipsum. Praesent mauris. Fusce nec tellus sed augue semper porta. Mauris massa. Vestibulum lacinia arcu eget nulla.',
    beforeImage: '/images/projects/warehouse-floor-before.jpeg',
    beforeAlt: 'Before: Commercial warehouse concrete floor before transformation',
    afterImage: '/images/projects/warehouse-flake-epoxy-after.png',
    afterAlt: 'After: Finished commercial warehouse floor',
    spec: 'Lorem ipsum dolor sit amet consectetur'
  }
];

const exteriorShowcases = [
  {
    label: 'Landmark Building',
    kicker: 'EXTERIOR & COMMERCIAL PAINTING',
    headline: 'Lorem Ipsum Dolor Sit Amet',
    story:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
    video: '/videos/before-after-video.mp4',
    beforeImage: '/images/projects/mcauley-building-before.png',
    beforeAlt: 'Before: Commercial building exterior before painting',
    afterImage: '/images/projects/mcauley-building-after.png',
    afterAlt: 'After: Finished commercial building exterior',
    spec: 'Lorem ipsum dolor sit amet consectetur'
  },
  {
    label: 'McDonald’s Awning',
    kicker: 'COMMERCIAL STOREFRONT EXTERIOR',
    headline: 'Consectetur Adipiscing Elit',
    story:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio. Praesent libero. Sed cursus ante dapibus diam. Sed nisi. Nulla quis sem at nibh elementum imperdiet.',
    beforeImage: '/images/projects/mcdonalds-696-awning-before.png',
    beforeAlt: 'Before: Commercial awning before painting',
    afterImage: '/images/projects/mcdonalds-696-awning-after.png',
    afterAlt: 'After: Finished commercial awning',
    spec: 'Lorem ipsum dolor sit amet consectetur'
  },
  {
    label: 'Cedar Fence Revival',
    kicker: 'RESIDENTIAL WOOD STAINING',
    headline: 'Sed Do Eiusmod Tempor Incididunt',
    story:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis sagittis ipsum. Praesent mauris. Fusce nec tellus sed augue semper porta. Mauris massa. Vestibulum lacinia arcu eget nulla.',
    beforeImage: '/images/projects/wood-fence-before.png',
    beforeAlt: 'Before: Wooden privacy fence before staining',
    afterImage: '/images/projects/wood-fence-stained-after.png',
    afterAlt: 'After: Finished stained wooden privacy fence',
    spec: 'Lorem ipsum dolor sit amet consectetur'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="AAC Painters Inc. | Quality Paint, Epoxy Flooring & Commercial Finishes (CSLB #1039849)"
  description="Quality Paint. Lasting Results. Licensed California painting and epoxy flooring contractor (CSLB #1039849). Explore interactive before & after transformations, real jobsite documentaries, and request a free estimate with Alex Delgadillo at (209) 485-5103."
  structuredData={faqSchema}
>
  <!-- 1. FULL-BLEED CINEMATIC HERO SECTION -->
  <section class="hero-banner" aria-labelledby="hero-heading" data-hero-banner>
    <div class="hero-bg-stage">
      <video
        src="/videos/before-after-video.mp4"
        poster="/images/projects/mcauley-building-after.png"
        width="1660"
        height="1244"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        class="hero-bg-video"
      ></video>
      <div class="hero-scrim" aria-hidden="true"></div>
    </div>

    <!-- Inline SVG Mask & Contractor Paintbrush Definitions (Modern Web Guidance: complex-shapes) -->
    <svg class="hero-svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <!-- objectBoundingBox scales mask coordinates (0 to 1) with each painted word's size -->
        <mask id="aac-bristle-swath-mask" maskContentUnits="objectBoundingBox">
          <!-- Rounded logo-style brushstroke body with tapered bristle tail -->
          <path
            d="M0.04,0.22 C0.01,0.38 0.01,0.68 0.05,0.82 C0.22,0.94 0.62,0.92 0.91,0.84 L0.99,0.76 L0.92,0.68 L1.0,0.56 L0.93,0.46 L0.98,0.32 L0.89,0.26 C0.60,0.12 0.20,0.10 0.04,0.22 Z"
            fill="white"
          />
          <!-- Semi-transparent dry-brush bristle streaks at edges (luminance masking: gray = semi-transparent) -->
          <path d="M0.08,0.12 C0.36,0.04 0.72,0.08 0.96,0.20 L0.90,0.28 C0.64,0.16 0.32,0.14 0.06,0.24 Z" fill="gray" />
          <path d="M0.06,0.80 C0.34,0.90 0.68,0.88 0.96,0.80 L0.92,0.92 C0.62,0.98 0.28,0.96 0.04,0.86 Z" fill="gray" />
        </mask>

        <!-- Reusable Pro Angled Sash Contractor Paintbrush Symbol (currentColor = Wet Logo Paint) -->
        <symbol id="aac-contractor-brush" viewBox="0 0 120 120">
          <!-- Wooden Handle (Angled Upper-Right) -->
          <path
            d="M68 6 L108 26 C112 28 113 33 110 37 L76 66 L52 46 L63 10 C64 6 66 5 68 6 Z"
            fill="#d99b52"
            stroke="#090d12"
            stroke-width="2.5"
          />
          <!-- Wood Grain Highlight -->
          <path d="M71 12 L102 28 L74 58" stroke="#f3c68f" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.65" />
          <!-- Handle Hang Hole -->
          <circle cx="94" cy="26" r="3.2" fill="#090d12" />
          <!-- Stainless Steel Ferrule -->
          <path
            d="M47 42 L80 63 L69 78 L36 57 Z"
            fill="#dbe4ee"
            stroke="#090d12"
            stroke-width="2.5"
          />
          <path d="M51 45 L77 62" stroke="#94a3b8" stroke-width="2" />
          <circle cx="53" cy="53" r="1.6" fill="#475569" />
          <circle cx="63" cy="59" r="1.6" fill="#475569" />
          <!-- Dark Natural Bristle Stock -->
          <path
            d="M36 57 L69 78 L50 104 L12 86 C18 76 28 66 36 57 Z"
            fill="#1b2430"
            stroke="#090d12"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
          <!-- Bristle Score Lines -->
          <path d="M42 64 L24 85 M50 69 L33 91 M58 74 L42 96" stroke="#334155" stroke-width="1.4" stroke-linecap="round" />
          <!-- Wet Logo-Colored Paint Loaded on Bristle Tip (Uses currentColor) -->
          <path
            d="M23 74 C31 76 44 82 57 93 L50 105 L10 87 C14 82 18 78 23 74 Z"
            fill="currentColor"
            stroke="#090d12"
            stroke-width="2"
            stroke-linejoin="round"
          />
          <!-- Glossy Wet Paint Specular Highlight on Bristle Tip -->
          <path d="M18 84 L46 97" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" opacity="0.78" />
          <!-- Active Wet Paint Bead / Drip at Leading Toe of Brush -->
          <circle cx="11" cy="94" r="4" fill="currentColor" />
          <circle cx="22" cy="101" r="2.5" fill="currentColor" />
        </symbol>
      </defs>
    </svg>

    <div class="container hero-container">
      <div class="hero-copy-block" data-hero-paint-stage>
        <div class="section-kicker hero-kicker-painted">
          <span class="kicker-bars kicker-bars-animated" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="kicker-text kicker-text-light kicker-text-brush-reveal">RESIDENTIAL, COMMERCIAL &amp; EPOXY FLOORING</span>
        </div>

        <h1 id="hero-heading" class="hero-title hero-title-painted">
          <span class="hero-title-line">
            <!-- STROKE 1: "Coloring" in AAC Logo Crimson Red (#EC193A) + Green (#9DBE39) Under-Stroke -->
            <span class="paint-word paint-word--coloring" style="--stroke-idx: 0;">
              <span class="paint-stroke-underlay" aria-hidden="true"></span>
              <span class="paint-splatters" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="paint-word-reveal">
                <span class="paint-word-ink" data-word="Coloring">Coloring</span>
              </span>
              <span class="word-brush-actor" aria-hidden="true">
                <svg viewBox="0 0 120 120" class="word-brush-svg"><use href="#aac-contractor-brush" /></svg>
              </span>
            </span>{' '}
            <!-- STROKE 2: "Your" in AAC Logo Cerulean Blue (#0493BC) -->
            <span class="paint-word paint-word--your" style="--stroke-idx: 1;">
              <span class="paint-stroke-underlay" aria-hidden="true"></span>
              <span class="paint-splatters" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="paint-word-reveal">
                <span class="paint-word-ink" data-word="Your">Your</span>
              </span>
              <span class="word-brush-actor" aria-hidden="true">
                <svg viewBox="0 0 120 120" class="word-brush-svg"><use href="#aac-contractor-brush" /></svg>
              </span>
            </span>
          </span>{' '}
          <span class="hero-title-line">
            <!-- STROKE 3: "Dreams." in AAC Logo Marigold Gold (#FCBB1F) -->
            <span class="paint-word paint-word--dreams" style="--stroke-idx: 2;" data-last-paint-word>
              <span class="paint-stroke-underlay" aria-hidden="true"></span>
              <span class="paint-splatters" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="paint-word-reveal">
                <span class="paint-word-ink" data-word="Dreams.">Dreams.</span>
              </span>
              <span class="word-brush-actor" aria-hidden="true">
                <svg viewBox="0 0 120 120" class="word-brush-svg"><use href="#aac-contractor-brush" /></svg>
              </span>
            </span>
          </span>
        </h1>

        <div class="hero-description-stage">
          <span class="hero-roller-lead" aria-hidden="true"></span>
          <p class="hero-description hero-description-painted">
            We bring new life to your home, garage, or commercial building with heavy diamond-ground prep, clean architectural finishes, and a licensed team ({brand.license}) that treats your space like their own.
          </p>
        </div>

        <div class="hero-actions hero-actions-painted">
          <a href="#quote-builder" class="btn btn-white">
            <span>Get a Free Estimate</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={brand.phoneHref} class="btn btn-outline-light">
            <span>Call {brand.phoneDisplay}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Signature 4-Color AAC Spectrum Bar at Bottom of Hero -->
    <div class="spectrum-bar" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
  </section>

  <!-- 2. "OUR SERVICES" LIGHT SPLIT SECTION (Exact Reference Mockup Layout + Real Interior/Exterior/Epoxy Photos) -->
  <section class="services-overview-section" id="our-services" aria-labelledby="services-heading">
    <div class="container">
      <div class="services-split-grid">
        <!-- Left Column: Kicker + Heading + 3 Vertical-Divider Icon Columns -->
        <div class="services-left-col">
          <div class="section-kicker">
            <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="kicker-text">Our Services</span>
          </div>

          <h2 id="services-heading" class="services-main-title">
            Interior, Exterior &amp; Epoxy Coating for Your Property
          </h2>

          <p class="services-lead">
            From single rooms, cabinet painting, and popcorn ceiling removal to full exterior stucco restorations, pressure washing, and diamond-ground epoxy floors, we deliver high-quality results that last.
          </p>

          <!-- 3 Icon Columns with Vertical Dividers (Matching Reference Mockup) -->
          <div class="services-icon-columns">
            <a
              href="/services/residential-painting"
              class="service-icon-col"
              data-service-preview="/images/projects/wood-fence-stained-after.png"
              data-service-caption="Residential Interior, Exterior, Cabinets, Popcorn Removal & Wood Staining"
            >
              <svg class="service-line-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 10.5L12 3l9 7.5V21a1 1 0 01-1 1H4a1 1 0 01-1-1V10.5z" />
                <path d="M9 21V13h6v8" />
              </svg>
              <h3 class="service-col-name">Residential &amp; Trim</h3>
              <span class="service-col-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a
              href="/services/commercial-painting"
              class="service-icon-col"
              data-service-preview="/images/projects/mcauley-building-after.png"
              data-service-caption="Commercial Exterior Stucco, HOAs, Hotels, Franchises & Multi-Bay Doors"
            >
              <svg class="service-line-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21h18" />
                <path d="M5 21V7l7-4 7 4v14" />
                <path d="M9 10h6M9 14h6" />
              </svg>
              <h3 class="service-col-name">Exterior &amp; Commercial</h3>
              <span class="service-col-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a
              href="/services/epoxy-flooring"
              class="service-icon-col"
              data-service-preview="/images/projects/residential-garage-flake-epoxy-after.png"
              data-service-caption="Full-Broadcast Flake & Liquid-Glass Mirror Epoxy Floors for Garages & Pool Decks"
            >
              <svg class="service-line-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                <polyline points="2 17 12 22 22 17" />
                <polyline points="2 12 12 17 22 12" />
              </svg>
              <h3 class="service-col-name">Epoxy Flooring</h3>
              <span class="service-col-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Large Bright Architectural Showcase Photo (Hovering/Focusing Service Columns Swaps Photo) -->
        <div class="services-right-col">
          <figure class="services-showcase-frame">
            <img
              src="/images/projects/residential-garage-flake-epoxy-after.png"
              alt="Showroom decorative flake epoxy garage floor and crisp painted walls by AAC Painters Inc."
              width="900"
              height="640"
              loading="lazy"
              decoding="async"
              class="services-showcase-img"
              id="services-preview-img"
            />
            <figcaption class="services-showcase-caption" id="services-preview-caption">
              Full-Broadcast Flake &amp; Liquid-Glass Epoxy Floors + Architectural Painting
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. TWO HIGH-IMPACT SIDE-BY-SIDE BEFORE & AFTER ROWS (Exact Mockup Layout + Inline Project Switcher) -->
  <section class="ba-showcase-section" id="our-work" aria-label="Before and After Project Transformations">
    <div class="container">
      <div class="featured-split-rows">
        <!-- ROW 1: EPOXY & FLOOR TRANSFORMATIONS ("From Dated to Modern") -->
        <article class="ba-split-row" data-ba-showcase="floors">
          <div class="ba-viewport" data-ba-slider>
            <img
              src={floorShowcases[0].afterImage}
              alt={floorShowcases[0].afterAlt}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="ba-img ba-img-after"
              data-showcase-after
            />
            <div class="ba-before-clip" style="--pos: 50%;">
              <img
                src={floorShowcases[0].beforeImage}
                alt={floorShowcases[0].beforeAlt}
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
                class="ba-img ba-img-before"
                data-showcase-before
              />
            </div>
            <!-- Wet Paint Brush Trail Canvas (Fades out after each swipe) -->
            <canvas class="ba-paint-canvas" aria-hidden="true"></canvas>

            <span class="ba-corner-badge ba-badge-before" aria-hidden="true">BEFORE</span>
            <span class="ba-corner-badge ba-badge-after" aria-hidden="true">AFTER</span>
            <div class="ba-divider" style="--pos: 50%; --brush-y: 50%; --brush-tilt: 0deg;" aria-hidden="true">
              <span class="ba-seam-wet-glow"></span>
              <div class="ba-handle">
                <span class="ba-brush-chevron ba-brush-chevron-left">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 18l-6-6 6-6" />
                  </svg>
                </span>
                <div class="ba-brush-actor">
                  <svg class="ba-brush-svg" width="64" height="64" viewBox="0 0 96 96" fill="none">
                    <path
                      d="M44 6 L52 6 C55 6 57 8 56 12 L59 38 L37 38 L40 12 C39 8 41 6 44 6 Z"
                      fill="#d99b52"
                      stroke="#090d12"
                      stroke-width="2.6"
                      stroke-linejoin="round"
                    />
                    <path d="M46 11 L45 34" stroke="#f3c68f" stroke-width="2" stroke-linecap="round" opacity="0.75" />
                    <circle cx="48" cy="13" r="2.4" fill="#090d12" />
                    <rect x="33" y="37" width="30" height="13" rx="2" fill="#dbe4ee" stroke="#090d12" stroke-width="2.6" />
                    <rect x="34.5" y="38.5" width="6.75" height="3.2" fill="#ec193a" />
                    <rect x="41.25" y="38.5" width="6.75" height="3.2" fill="#9dbe39" />
                    <rect x="48" y="38.5" width="6.75" height="3.2" fill="#0493bc" />
                    <rect x="54.75" y="38.5" width="6.75" height="3.2" fill="#fcbb1f" />
                    <circle cx="39" cy="45.5" r="1.4" fill="#475569" />
                    <circle cx="48" cy="45.5" r="1.4" fill="#475569" />
                    <circle cx="57" cy="45.5" r="1.4" fill="#475569" />
                    <path
                      d="M33 50 L63 50 L68 74 C58 78 38 78 28 74 Z"
                      fill="#1b2430"
                      stroke="#090d12"
                      stroke-width="2.6"
                      stroke-linejoin="round"
                    />
                    <path d="M40 52 L37 68 M48 52 L48 69 M56 52 L59 68" stroke="#334155" stroke-width="1.5" stroke-linecap="round" />
                    <path
                      d="M30 62 C38 60 58 60 66 62 L69 75 C58 80 38 80 27 75 Z"
                      fill="#14a8e8"
                      stroke="#090d12"
                      stroke-width="2.4"
                      stroke-linejoin="round"
                    />
                    <path d="M33 67 Q48 65 63 67" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" opacity="0.85" />
                    <circle class="ba-brush-drip" cx="38" cy="82" r="3.2" fill="#14a8e8" stroke="#090d12" stroke-width="1.5" />
                    <circle class="ba-brush-drip ba-brush-drip-2" cx="56" cy="84" r="2.4" fill="#fcbb1f" stroke="#090d12" stroke-width="1.4" />
                  </svg>
                </div>
                <span class="ba-brush-chevron ba-brush-chevron-right">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                </span>
              </div>
            </div>
            <label for="slider-floors-main" class="sr-only">Compare before and after floor transformation</label>
            <input
              id="slider-floors-main"
              type="range"
              min="0"
              max="100"
              value="50"
              class="ba-range-input"
              aria-label="Before and after comparison slider for floor transformations"
            />
          </div>

          <div class="ba-story-col">
            <div class="section-kicker">
              <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span class="kicker-text" data-showcase-kicker>{floorShowcases[0].kicker}</span>
            </div>

            <h2 class="ba-row-heading" data-showcase-headline>{floorShowcases[0].headline}</h2>
            <p class="ba-row-copy" data-showcase-story>{floorShowcases[0].story}</p>
            <p class="ba-row-spec" data-showcase-spec><strong>System:</strong> {floorShowcases[0].spec}</p>

            <!-- Compact Inline Project Switcher (Zero Vertical Bloat!) -->
            <div class="ba-inline-switcher" role="group" aria-label="Switch floor transformation project">
              {floorShowcases.map((item, idx) => (
                <button
                  type="button"
                  class:list={['ba-thumb-pill', { 'is-active': idx === 0 }]}
                  data-kicker={item.kicker}
                  data-headline={item.headline}
                  data-story={item.story}
                  data-spec={item.spec}
                  data-before={item.beforeImage}
                  data-before-alt={item.beforeAlt}
                  data-after={item.afterImage}
                  data-after-alt={item.afterAlt}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  <img src={item.afterImage} alt="" width="44" height="32" loading="lazy" decoding="async" />
                  <span>{item.label}</span>
                </button>
              ))}
            </div>

            <a href="/projects" class="arrow-link">
              <span>View More Projects</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>

        <!-- ROW 2: EXTERIOR & COMMERCIAL PAINTING ("Curb Appeal That Lasts") -->
        <article class="ba-split-row" data-ba-showcase="exteriors">
          <div class="ba-viewport" data-ba-slider>
            <video
              src={exteriorShowcases[0].video}
              poster={exteriorShowcases[0].afterImage}
              width="1660"
              height="1244"
              loading="lazy"
              autoplay
