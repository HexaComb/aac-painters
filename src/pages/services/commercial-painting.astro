---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfterCard from '../../components/BeforeAfterCard.astro';
import StoryChapters from '../../components/StoryChapters.astro';
import QuoteBuilderForm from '../../components/QuoteBuilderForm.astro';
import ServiceOverview from '../../components/ServiceOverview.astro';
import ServiceLocalContext from '../../components/ServiceLocalContext.astro';
import { makeServiceStructuredData } from '../../data/seo';
import { brand, beforeAfterGallery } from '../../data/siteData';
import { optimizedImageUrl, optimizedBeforeAfterPair } from '../../utils/optimizedImages';

const commercialPairs = await Promise.all(
  beforeAfterGallery.filter((item) => item.category === 'Commercial').map(optimizedBeforeAfterPair),
);
const heroImageUrl = await optimizedImageUrl('/images/projects/mcauley-building-after.png');
---

<BaseLayout
  title="Commercial Painting in Modesto & Turlock | AAC Painters"
  description="Commercial exterior and interior painting for storefronts, warehouses and multi-unit properties in Modesto, Turlock and the Central Valley. Request a bid."
  canonicalPath="/services/commercial-painting/"
  structuredData={makeServiceStructuredData({ path: "/services/commercial-painting/", name: "Commercial Painting & Industrial Coatings", description: "Commercial interior and exterior painting for storefronts, warehouses, apartment communities and businesses in the Central Valley." })}
  ogImage="/images/projects/mcauley-building-after.png"
>
  <section class="subpage-hero">
    <div class="subpage-hero-bg">
      <img
        src={heroImageUrl}
        alt="Painted commercial building exterior"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <div class="subpage-scrim" aria-hidden="true"></div>
    </div>

    <div class="container subpage-hero-inner">
      <nav aria-label="Breadcrumb" class="breadcrumb-nav">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Commercial Painting &amp; Coatings</span>
      </nav>

      <h1 class="subpage-title">
        Commercial Painting in<br />
        <span class="accent-blue">Modesto &amp; Turlock.</span>
      </h1>

      <p class="subpage-lead">
        From storefront exteriors to commercial interiors, AAC Painters helps property owners plan surface preparation, business access and scheduling in Modesto, Turlock and the Central Valley.
      </p>

      <div class="subpage-actions">
        <a href="#quote-builder" class="btn btn-white">
          <span>Request Commercial Bid</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={brand.phoneHref} class="btn btn-outline-light">
          <span>Call {brand.phoneDisplay}</span>
        </a>
      </div>
    </div>

    <div class="spectrum-bar" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
  </section>

  <ServiceOverview serviceId="commercial-painting" />

  <ServiceLocalContext
    id="commercial-service-area"
    eyebrow="COMMERCIAL PAINTING · CENTRAL VALLEY"
    heading="Commercial painters for active businesses and properties"
    summary="AAC Painters offers commercial interior and exterior repaints for storefronts, warehouses, apartment properties, HOA communities and other facilities across Modesto, Turlock and surrounding Central Valley cities. A site-specific bid can account for tenant access, surface repairs, coatings and project phasing."
    projectNote="Our portfolio documents a real corner storefront repaint, exterior surface preparation and canopy work so property teams can inspect the process before requesting a bid."
    considerations={["Building type, elevations, doors, trim or interior spaces included", "Business hours, tenant access, safety and staging requirements", "Existing surfaces, repair needs, color selections and target dates"]}
    related={[{ href: "/services/residential-painting/", label: "Residential painting" }, { href: "/services/epoxy-flooring/", label: "Commercial floor coatings" }]}
  />

  <section class="comm-showcase-section">
    <div class="container">
      <div class="section-kicker">
        <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="kicker-text">Commercial Before &amp; After</span>
      </div>
      <h2 class="section-heading">Commercial Exteriors &amp; Storefronts</h2>
      <div class="split-wrap">
        {commercialPairs.map((pair) => (
          <BeforeAfterCard item={pair} layout="split-row" />
        ))}
      </div>
    </div>
  </section>

  <StoryChapters />
  <QuoteBuilderForm />
</BaseLayout>

<style>
  .subpage-hero {
    position: relative;
    background: var(--bg-dark-deep);
    color: var(--text-light);
    overflow: hidden;
  }

  .subpage-hero-bg {
    position: absolute;
    inset: 0;
  }

  .subpage-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .subpage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 13, 18, 0.92) 0%, rgba(11, 16, 23, 0.78) 55%, rgba(11, 16, 23, 0.4) 100%);
  }

  .subpage-hero-inner {
    position: relative;
    z-index: 1;
    padding: 5rem 1.5rem;
    max-width: 720px;
    margin-left: max(var(--gutter), calc((100% - var(--container-max)) / 2));
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-light-secondary);
    margin-bottom: 1rem;
  }

  .subpage-title {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    margin-bottom: 1.15rem;
  }

  .subpage-lead {
    font-size: 1.05rem;
    color: var(--text-light-secondary);
    margin-bottom: 2rem;
  }

  .subpage-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .comm-showcase-section {
    padding: 5.5rem 1.5rem;
    background: var(--bg-white);
  }

  .section-heading {
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    color: var(--text-dark);
    margin-bottom: 2.5rem;
  }

  .split-wrap {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
</style>
