---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfterCard from '../../components/BeforeAfterCard.astro';
import QuoteBuilderForm from '../../components/QuoteBuilderForm.astro';
import ServiceOverview from '../../components/ServiceOverview.astro';
import ServiceLocalContext from '../../components/ServiceLocalContext.astro';
import { makeServiceStructuredData } from '../../data/seo';
import { brand, beforeAfterGallery, dustBagsProof } from '../../data/siteData';
import { optimizedImageUrl, optimizedBeforeAfterPair } from '../../utils/optimizedImages';

const epoxyPairs = await Promise.all(
  beforeAfterGallery
    .filter((item) => item.category === 'Epoxy Flooring' || item.id === 'residential-garage-masterpiece')
    .map(optimizedBeforeAfterPair),
);
const heroImageUrl = await optimizedImageUrl('/images/projects/residential-garage-flake-epoxy-after.png');
---

<BaseLayout
  title="Epoxy Flooring in Modesto & Turlock | AAC Painters"
  description="Garage epoxy flooring, decorative flake and commercial concrete coatings in Modesto, Turlock and the Central Valley. See real projects and request an estimate."
  canonicalPath="/services/epoxy-flooring/"
  structuredData={makeServiceStructuredData({ path: "/services/epoxy-flooring/", name: "Epoxy Flooring & Concrete Coatings", description: "Garage epoxy floors, decorative flake systems, commercial concrete coatings, concrete preparation and grind-and-seal options in the Central Valley." })}
  ogImage="/images/projects/residential-garage-flake-epoxy-after.png"
>
  <!-- Dark Hero Banner with 4-Color Spectrum Bar -->
  <section class="subpage-hero">
    <div class="subpage-hero-bg">
      <img
        src={heroImageUrl}
        alt="Completed full-broadcast granite flake epoxy garage floor by AAC Painters Inc."
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <div class="subpage-scrim" aria-hidden="true"></div>
    </div>

    <div class="container subpage-hero-inner">
      <nav aria-label="Breadcrumb" class="breadcrumb-nav">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Epoxy &amp; Metallic Flooring</span>
      </nav>

      <h1 class="subpage-title">
        Epoxy Flooring in<br />
        <span class="accent-blue">Modesto &amp; Turlock.</span>
      </h1>

      <p class="subpage-lead">
        Planning a garage epoxy floor or commercial concrete coating in the Central Valley? See real garage, auto-bay and warehouse results, then ask about surface preparation, finish options and cure time for your slab.
      </p>

      <div class="subpage-actions">
        <a href="#quote-builder" class="btn btn-white">
          <span>Get a Free Floor Estimate</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={brand.phoneHref} class="btn btn-outline-light">
          <span>Call {brand.phoneDisplay}</span>
        </a>
      </div>
    </div>

    <div class="spectrum-bar" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
  </section>

  <ServiceOverview serviceId="epoxy-flooring" />

  <ServiceLocalContext
    id="epoxy-service-area"
    eyebrow="EPOXY & CONCRETE COATINGS · CENTRAL VALLEY"
    heading="Garage epoxy floors and concrete coatings in Modesto & Turlock"
    summary="AAC Painters helps homeowners and commercial operators compare decorative flake, epoxy, metallic and grind-and-seal options. For garages, auto-service bays and warehouse floors in Modesto, Turlock and surrounding communities, the right finish depends on concrete condition, traffic, appearance and maintenance expectations."
    projectNote="Compare the documented garage, auto-service bay and warehouse floor transformations below. Separate auto-service bay photos show grinding and patched areas before the completed surface."
    considerations={["Floor size, existing coating, stains, cracks or moisture concerns", "Garage, vehicle, equipment or commercial traffic and desired appearance", "Surface preparation, cure time and when the floor must return to use"]}
    related={[{ href: "/services/residential-painting/", label: "Residential painting" }, { href: "/services/commercial-painting/", label: "Commercial painting" }]}
  />

  <!-- 6-Bag Dust Proof & Technical Spec Section -->
  <section class="prep-spec-section">
    <div class="container prep-spec-grid">
      <div>
        <div class="section-kicker">
          <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="kicker-text">Mechanical Surface Preparation</span>
        </div>
        <h2 class="section-heading">Start with the Surface.</h2>
        <p class="section-copy">
          Surface preparation, repairs, and coating selection should be reviewed together. Your estimate can outline the preparation and finish recommended for the slab and how you plan to use it.
        </p>

        <dl class="spec-list">
          <div class="spec-row">
            <dt>Surface Review</dt>
            <dd>Identify existing coatings, contamination, and areas needing preparation.</dd>
          </div>
          <div class="spec-row">
            <dt>Preparation &amp; Repairs</dt>
            <dd>Discuss grinding and repair needs before choosing the coating system.</dd>
          </div>
          <div class="spec-row">
            <dt>Finish Selection</dt>
            <dd>Compare decorative flake, solid-color, and metallic floor options.</dd>
          </div>
          <div class="spec-row">
            <dt>Use &amp; Care</dt>
            <dd>Confirm cure times, return-to-use timing, and maintenance for the selected finish.</dd>
          </div>
        </dl>
      </div>

      <figure class="prep-proof-card">
        <img
          src={dustBagsProof.image}
          alt={dustBagsProof.alt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <strong>{dustBagsProof.headline}</strong>
          <p>{dustBagsProof.caption}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Interactive Before & After Epoxy Transformations -->
  <section class="epoxy-ba-section">
    <div class="container">
      <div class="section-kicker">
        <span class="kicker-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="kicker-text">Epoxy &amp; Concrete Before &amp; Afters</span>
      </div>
      <h2 class="section-heading">Garage, Auto Bay &amp; Warehouse Floor Projects</h2>
      <p class="proof-intro">See three real floor transformations with different starting surfaces and finishes. The <a href="/projects/#our-process">auto-service bay documentary</a> also shows grinding and patching; preparation for a new floor depends on its condition.</p>

      <div class="split-list">
        {epoxyPairs.map((pair) => (
          <BeforeAfterCard item={pair} layout="split-row" />
        ))}
      </div>
    </div>
  </section>

  <QuoteBuilderForm />
</BaseLayout>

<style>
  .subpage-hero {
    position: relative;
    background: var(--bg-dark-deep);
    color: var(--text-light);
    overflow: hidden;
  }

  .subpage-hero-bg {
    position: absolute;
    inset: 0;
  }

  .subpage-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .subpage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 13, 18, 0.92) 0%, rgba(11, 16, 23, 0.78) 55%, rgba(11, 16, 23, 0.4) 100%);
  }

  .subpage-hero-inner {
    position: relative;
    z-index: 1;
    padding: 5rem 1.5rem;
    max-width: 720px;
    margin-left: max(var(--gutter), calc((100% - var(--container-max)) / 2));
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-light-secondary);
    margin-bottom: 1rem;
  }

  .breadcrumb-nav a:hover {
    color: var(--aac-blue);
  }

  .subpage-title {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    margin-bottom: 1.15rem;
  }

  .subpage-lead {
    font-size: 1.05rem;
    color: var(--text-light-secondary);
    margin-bottom: 2rem;
  }

  .subpage-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .prep-spec-section {
    padding: 5.5rem 1.5rem;
    background: var(--bg-light);
    border-bottom: 1px solid var(--border-light);
  }

  .prep-spec-grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: 3rem;
    align-items: center;
  }

  .section-heading {
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    color: var(--text-dark);
    margin-bottom: 1rem;
  }

  .section-copy {
    font-size: 1rem;
    color: var(--text-dark-secondary);
    margin-bottom: 1.75rem;
  }

  .spec-list {
    border-top: 2px solid var(--text-dark);
    padding: 1rem;
  }

  .spec-row {
    padding: 0.9rem 0.5rem;
    border-bottom: 1px solid var(--border-light-strong);
  }

  .spec-row dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.98rem;
    color: var(--text-dark);
  }

  .spec-row dd {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
  }

  .prep-proof-card {
    background: var(--bg-dark);
    color: var(--text-light);
    border-radius: 4px;
    overflow: hidden;
  }

  .prep-proof-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .prep-proof-card figcaption {
    padding: 1.35rem;
  }

  .prep-proof-card strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
    color: var(--aac-yellow);
  }

  .prep-proof-card p {
    font-size: 0.92rem;
    color: var(--text-light-secondary);
  }

  .epoxy-ba-section {
    padding: 5.5rem 1.5rem;
    background: var(--bg-white);
  }

  .proof-intro { max-width: 68ch; margin: 0 0 2rem; color: var(--text-dark-secondary); line-height: 1.7; }
  .proof-intro a { color: var(--aac-blue-deep); text-underline-offset: 4px; }

  .split-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 960px) {
    .prep-spec-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
