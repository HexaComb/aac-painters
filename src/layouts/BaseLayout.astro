---
import '../styles/global.css';
import { brand, seoServiceAreas } from '../data/siteData';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'AAC Painters Inc. | Quality Paint, Epoxy Flooring & Commercial Finishes',
  description = 'Quality Paint. Lasting Results. Licensed California painting and epoxy flooring contractor (CSLB #1039849). View 7 real before-and-after transformations, 4-stage jobsite documentaries, and request a free estimate with Alex Delgadillo at (209) 485-5103.',
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/projects/mcauley-building-after.png',
  structuredData
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, brand.domain).toString();
const ogImageUrl = new URL(ogImage, brand.domain).toString();
const currentPath = Astro.url.pathname;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['HousePainter', 'HomeAndConstructionBusiness', 'LocalBusiness'],
      '@id': `${brand.domain}/#organization`,
      name: brand.name,
      alternateName: 'AAC Painters',
      slogan: 'Quality Paint. Lasting Results.',
      description,
      url: brand.domain,
      logo: new URL('/images/brand/aac-painters-logo.png', brand.domain).toString(),
      telephone: brand.phoneE164,
      priceRange: '$$',
      image: [
        new URL('/images/brand/aac-painters-logo.png', brand.domain).toString(),
        new URL('/images/projects/mcauley-building-after.png', brand.domain).toString(),
        new URL('/images/projects/auto-shop-epoxy-floor-after.png', brand.domain).toString(),
        new URL('/images/projects/residential-garage-flake-epoxy-after.png', brand.domain).toString(),
        new URL('/images/projects/warehouse-flake-epoxy-after.png', brand.domain).toString()
      ],
      founder: {
        '@type': 'Person',
        name: brand.president,
        jobTitle: brand.presidentTitle
      },
      areaServed: seoServiceAreas.map((city) => ({
        '@type': 'City',
        name: `${city}, CA`
      })),
      sameAs: [brand.instagramUrl, brand.facebookSearchUrl]
    }
  ]
};

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Google Fonts: Schibsted Grotesk (Bold Geometric Display), Public Sans (Body), JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Public+Sans:wght@400;500;600;700&family=Schibsted+Grotesk:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Dark Slate Navigation Header (Matching Reference Mockup) -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo" aria-label="AAC Painters Inc. Home">
          <img
            src="/images/brand/aac-painters-logo.png"
            alt="AAC Painters Inc. — Coloring Your Dream"
            class="aac-logo-img"
            width="86"
            height="79"
            decoding="async"
          />
        </a>

        <nav class="main-nav" aria-label="Primary Navigation">
          <a href="/" class:list={['nav-link', { 'is-active': currentPath === '/' }]}>Home</a>
          <a href="/#our-services" class:list={['nav-link', { 'is-active': currentPath.startsWith('/services') }]}>Services</a>
          <a href="/#our-work" class:list={['nav-link', { 'is-active': currentPath.startsWith('/projects') }]}>Our Work</a>
          <a href="/#why-choose-us" class="nav-link">About &amp; Proof</a>
          <a href="/#our-process" class="nav-link">Process</a>
          <a href="/#reviews" class="nav-link">Project Videos</a>
        </nav>

        <div class="header-actions">
          <a href={brand.phoneHref} class="header-phone" aria-label={`Call ${brand.phoneDisplay}`}>
            {brand.phoneDisplay}
          </a>
          <a href="#quote-builder" class="header-estimate-pill">
            <span>Get a Free Estimate</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- 4-Color AAC Spectrum Divider Bar Above Footer -->
    <div class="spectrum-bar" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>

    <!-- Dark Slate Footer (Matching Reference Mockup) -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <a href="/" class="brand-logo" aria-label="AAC Painters Inc. Home">
            <img
              src="/images/brand/aac-painters-logo.png"
              alt="AAC Painters Inc. — Coloring Your Dream"
              class="aac-logo-img aac-logo-footer"
              width="112"
              height="103"
              loading="lazy"
              decoding="async"
            />
          </a>

          <nav class="footer-nav" aria-label="Footer Navigation">
            <a href="/">Home</a>
            <a href="/services/residential-painting">Residential</a>
            <a href="/services/commercial-painting">Commercial</a>
            <a href="/services/epoxy-flooring">Epoxy Floors</a>
            <a href="/projects">Our Work</a>
            <a href="/#reviews">Project Videos</a>
            <a href="#quote-builder">Free Estimate</a>
          </nav>

          <div class="footer-contact">
            <a href={brand.facebookSearchUrl} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="AAC Painters Inc on Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V22h3.4z"/>
              </svg>
            </a>
            <a href={brand.instagramUrl} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="AAC Painters Inc on Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="4.5" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
            </a>
            <a href={brand.phoneHref} class="footer-phone">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
              </svg>
              <span>{brand.phoneDisplay}</span>
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-seo-line">
            Residential Painting &bull; Interior Painting &bull; Exterior Painting &bull; Full-Broadcast &amp; Metallic Epoxy Flooring &bull; Commercial &amp; Auto Shop Coatings &bull; CA License #{brand.license.replace('CSLB #', '')}
          </p>
          <p class="footer-cities">
            Serving {seoServiceAreas.slice(0, 10).join(' • ')} &amp; Northern California
          </p>
        </div>
      </div>
    </footer>

    <!-- IntersectionObserver Fallback for Scroll Entry Effects -->
    <script>
      const supportsViewTimeline =
        typeof CSS !== 'undefined' &&
        CSS.supports('animation-timeline: view()') &&
        CSS.supports('animation-range: entry');

      if (!supportsViewTimeline) {
        const items = document.querySelectorAll('.reveal-on-scroll');
        if ('IntersectionObserver' in window && items.length > 0) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 }
          );
          items.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 999;
    padding: 0.75rem 1.25rem;
    background: var(--aac-blue);
    color: var(--bg-dark-deep);
    font-weight: 700;
  }

  .skip-link:focus {
    top: 1rem;
  }

  /* Dark Slate Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(11, 16, 22, 0.96);
    color: var(--text-light);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-dark);
    padding: 0.35rem 1.5rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5.25rem;
    padding-block: 0.35rem;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .aac-logo-img {
    width: 86px;
    height: 79px;
    object-fit: contain;
    filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.32)) drop-shadow(0 3px 10px rgba(0, 0, 0, 0.45));
    transition: transform 180ms ease;
  }

  .brand-logo:hover .aac-logo-img {
    transform: scale(1.03);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .nav-link {
    position: relative;
    padding-block: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light-secondary);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text-light);
  }

  /* Signature red active bar from mockup */
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    background-color: var(--aac-red);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .header-phone {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-light-secondary);
  }

  .header-phone:hover {
    color: var(--aac-blue);
  }

  /* Outlined Pill Button from Reference Header */
  .header-estimate-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-light);
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .header-estimate-pill:hover {
    background-color: var(--aac-blue);
    border-color: var(--aac-blue);
    color: var(--bg-dark-deep);
  }

  /* Dark Slate Footer */
  .site-footer {
    background-color: var(--bg-dark-deep);
    color: var(--text-light-secondary);
    padding-block: 3rem 2.5rem;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-dark);
  }

  .aac-logo-footer {
    width: 112px;
    height: 103px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-nav a {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light-secondary);
  }

  .footer-nav a:hover {
    color: var(--aac-blue);
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background-color: var(--bg-dark-elevated);
    color: var(--text-light);
  }

  .social-icon:hover {
    background-color: var(--aac-blue);
    color: var(--bg-dark-deep);
  }

  .footer-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-light);
  }

  .footer-phone:hover {
    color: var(--aac-blue);
  }

  .footer-bottom {
    padding-top: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }

  .footer-seo-line {
    font-size: 0.875rem;
    color: var(--text-light-secondary);
    max-width: none;
  }

  .footer-cities {
    font-size: 0.85rem;
    color: var(--text-light-muted);
    max-width: none;
  }

  @media (max-width: 1024px) {
    .main-nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header-phone {
      display: none;
    }

    .footer-top {
      flex-direction: column;
      text-align: center;
    }

    .footer-nav {
      justify-content: center;
    }
  }
</style>
